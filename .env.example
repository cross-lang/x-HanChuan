# 运行环境：development / testing / production
# APP_ENV=development

# 服务器配置（环境变量前缀 SERVER_）
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_DEBUG=true

# 日志配置
LOGGING_LEVEL=INFO
# 日志格式：json（结构化，适合 Loki/ELK）| console（彩色人可读，适合本地开发）
LOGGING_FORMAT=json
LOGGING_FILE_PATH=logs/x-HanChuan-{time:YYYYMMDDHH}.log
LOGGING_ROTATION=1 hour
LOGGING_RETENTION=7 days
LOGGING_COMPRESSION=zip
LOGGING_CONSOLE_OUTPUT=true

# 跨域配置（环境变量前缀 CORS_）
# CORS_ENABLED=true
# CORS_ORIGINS=*
# CORS_ALLOW_CREDENTIALS=true
# CORS_ALLOW_METHODS=*
# CORS_ALLOW_HEADERS=*
