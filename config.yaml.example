# ============================================================
# x-HanChuan 配置示例（YAML 格式）
# ============================================================
# 复制此文件为 config.yaml 并按需修改：
#   cp config.yaml.example config.yaml
#
# 配置优先级：环境变量 > config.{env}.yaml > config.yaml > 代码默认值
# ============================================================

# 运行环境：development / testing / production
# app_env: development

# 服务器配置
server:
  host: "0.0.0.0"          # 监听地址
  port: 8000               # 监听端口
  debug: true              # 调试模式（生产环境设为 false）

# 日志配置
logging:
  level: "INFO"            # 日志级别: DEBUG / INFO / WARNING / ERROR / CRITICAL
  format: "json"           # 控制台格式: "json"（生产）/ "console"（开发）
  file_path: "logs/x-HanChuan-{time:YYYYMMDDHH}.log"  # 日志文件路径
  rotation: "1 hour"       # 轮转周期: "1 hour" / "1 day" / "100 MB"
  retention: "7 days"      # 保留时间: "7 days" / "30 days"
  compression: "zip"       # 压缩格式
  console_output: true     # 是否输出到控制台

# 跨域配置
cors:
  enabled: true
  origins:
    - "*"
  allow_credentials: true
  allow_methods:
    - "*"
  allow_headers:
    - "*"
